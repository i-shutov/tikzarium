{
  "schema_version": 1,
  "provenance": "Project-authored QA cases; examples/ fixtures are from TikZarium W01. R4 corpus not imported.",
  "cases": [
    {
      "id": "g00-quickstart",
      "project_dir": "examples",
      "source": "quickstart.tex",
      "expect": "pdf",
      "pages": 1
    },
    {
      "id": "g00-legacy-cyrillic-pdf-only",
      "project_dir": "examples",
      "source": "cyrillic.tex",
      "expect": "pdf",
      "pages": 1,
      "note": "Compiles to PDF but may drop Cyrillic glyphs with default Latin Modern; not a Unicode glyph validation."
    },
    {
      "id": "g00-cyrillic-glyph-audit",
      "project_dir": "fixtures/qa/g00-cyrillic-glyph-audit",
      "source": "main.tex",
      "expect": "pdf",
      "pages": 1,
      "check_no_missing_glyphs": true,
      "text_expect": "Тест XeLaTeX и Unicode. Кириллица."
    },
    {
      "id": "g01-multifile-unicode-path",
      "project_dir": "fixtures/qa/g01-multifile",
      "source": "main.tex",
      "expect": "pdf",
      "pages": 1,
      "unicode_path": true
    },
    {
      "id": "g02-tikz-fonts",
      "project_dir": "fixtures/qa/g02-tikz-fonts",
      "source": "main.tex",
      "expect": "pdf",
      "pages": 1,
      "check_no_missing_glyphs": true,
      "text_expect": [
        "Оптика и квантовая яма",
        "Греческие символы αβγ"
      ],
      "font_expect": [
        "DejaVuSerif",
        "LatinModernMath"
      ],
      "note": "Text and math must be actual Unicode/XeLaTeX fontspec+unicode-math content within TikZ nodes. pdffonts evidence is separately marked NOT_CHECKED when tool is absent."
    },
    {
      "id": "g08-intentional-tex-error",
      "project_dir": "fixtures/qa/g08-error",
      "source": "main.tex",
      "expect": "tex-error"
    }
  ]
}
