  "measurement": {
    "clock": "std::time::Instant wall-clock elapsed around CPU-only operations",
    "repetitions": "5 for 10k job/token operations and galley idle; 3 for 100k operations, sequential galley edit, and incomplete begin scans; initial and first edit are single samples",
