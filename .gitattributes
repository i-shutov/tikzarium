# Keep only the versioned Rust dependency lock byte-identical across hosted OS.
# Do not impose line ending normalization on user-managed .tex/.tikz sources.
Cargo.lock text eol=lf
# Reviewed fixed maintenance fixture is checked byte-for-byte before execution.
scripts/maintenance/trusted-compiler-smoke.tex text eol=lf
# This repository-owned proof fixture is compared byte-for-byte across Windows/Linux.
examples/windows-cyrillic.tex text eol=lf

# Scientific-142 supplied originals and data have manifest SHA-256 over their exact bytes.
# Windows git checkout must NOT convert their TeX or .dat LF to CRLF.
/roadmap/Tikzarium_Scientific_142_R4/fixtures/** -text
/roadmap/Tikzarium_Scientific_142_R4/provenance/** -text
# The recovered native UI atlas is an immutable binary artifact.
design/studio-compact-atlas/published/*.pdf binary
# Raw command captures retain their terminal blank lines byte-for-byte.
insights/assets/2026-11-12-compact-recovery/*.log whitespace=-blank-at-eof
insights/assets/2026-11-13-shared-history/*.log whitespace=-blank-at-eof
insights/assets/2026-11-13-shared-history/baseline-ci-audit.md whitespace=-blank-at-eof
insights/assets/2026-11-13-shared-history/**/*.log whitespace=-blank-at-eof
insights/assets/2026-11-13-shared-history/native-attempts/** whitespace=-blank-at-eof
# Native evidence copies retain the original source line endings and log bytes.
insights/assets/2026-11-13-hosted-scientific/*.tex -text whitespace=cr-at-eol
insights/assets/2026-11-13-hosted-scientific/*.log whitespace=-blank-at-eof,-blank-at-eol
insights/assets/2026-11-13-hosted-scientific/independent-original-review.md whitespace=-blank-at-eof
